# ==============================================================================
# SL Music Backend - Production Environment Configuration
# ==============================================================================
NODE_ENV=production
PORT=5000

# AWS RDS MariaDB 10.11 (Ohio us-east-2)
MYSQL_HOST=sl-database-main.c9isy40g0iyc.us-east-2.rds.amazonaws.com
MYSQL_PORT=3306
MYSQL_DATABASE=sl_music_prod
MYSQL_USER=sl_prod_user
MYSQL_PASSWORD=SlProd#2026

# Migrated AWS S3 Storage (Ohio us-east-2)
AWS_REGION=us-east-2
S3_BUCKET_NAME=sl-music-publication
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Security & Tokens
JWT_SECRET=your_production_jwt_secret_key

# Stripe Payment Gateway
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Frontend URLs (CORS)
FRONTEND_URL=https://slmusic.org
ALLOWED_ORIGINS=https://slmusic.org,https://www.slmusic.org
